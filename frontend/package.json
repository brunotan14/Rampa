{
  "name": "rampa-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "api-types": "node scripts/generate-api-types.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@tanstack/react-query": "5.108.3",
    "phoenix": "1.8.17",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/phoenix": "1.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "fsevents": false
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.8",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
