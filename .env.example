# Variáveis de ambiente do Rampa. Copie para `.env` (fora do Git) e preencha.
# Em dev e test os valores padrão já funcionam; em produção, as marcadas como obrigatórias
# precisam estar definidas. Nunca coloque segredos reais neste arquivo.

## Backend (Phoenix)

# Conexão com o PostgreSQL (obrigatória em produção).
DATABASE_URL=ecto://postgres:postgres@localhost:5432/rampa_dev
# Segredo do Phoenix; gere com `mix phx.gen.secret` (obrigatório em produção).
SECRET_KEY_BASE=
# Domínio público do app (obrigatório em produção): URLs geradas e origem aceita no websocket.
PHX_HOST=localhost
# Outras origens aceitas no websocket `/socket` em produção, além de https://PHX_HOST, separadas
# por vírgula (ex.: https://staging.exemplo.com.br). Sem curinga: valor inválido impede a subida.
PHX_ALLOWED_ORIGINS=
# Porta HTTP do Phoenix.
PORT=4000
# Em release, `true` sobe o servidor HTTP.
PHX_SERVER=
# Conexões do pool do banco em produção.
POOL_SIZE=10
# `true` conecta ao banco por IPv6.
ECTO_IPV6=
# Consulta DNS para formar cluster de nós Erlang (vazio: sem cluster).
DNS_CLUSTER_QUERY=
# Endereço do scanner, visto pelo backend.
SCANNER_URL=http://localhost:4100
# Páginas varridas ao mesmo tempo (fila `scan` do Oban).
SCAN_CONCURRENCY=2
# Hosts liberados da proteção contra SSRF, separados por vírgula. Só no Compose de teste; nunca em produção (o app não sobe).
SSRF_ALLOWLIST=
# Faixas CIDR do proxy reverso (Traefik), separadas por vírgula; só delas o X-Forwarded-For vale.
TRUSTED_PROXIES=
# Segredo do HMAC do IP de quem pede auditorias; gere com `mix phx.gen.secret` (obrigatório em produção, 32+ caracteres).
IP_HASH_SECRET=
# Auditorias por hora por IP.
AUDITS_PER_IP_PER_HOUR=5
# Auditorias por dia (dia de São Paulo), somando todos os IPs.
AUDITS_DAILY_LIMIT=50

## Scanner (Node + Playwright)

# Porta HTTP do scanner.
# PORT=4100
# Interface em que o scanner escuta.
HOST=127.0.0.1
# `production` recusa subir com SSRF_ALLOWLIST preenchida; o Compose de teste usa `test`.
NODE_ENV=development
# Limite total de uma varredura, em milissegundos.
SCAN_TOTAL_TIMEOUT_MS=90000

## Deploy (só no `/opt/rampa/.env` da VPS, dono `deploy`, permissão 600)
# Lidas pelo `infra/docker-compose.prod.yml` e pelo `infra/deploy.sh`. Além destas, o `.env` da
# VPS tem PHX_HOST, SECRET_KEY_BASE, IP_HASH_SECRET e TRUSTED_PROXIES (acima). Sem SSRF_ALLOWLIST.

# Senha do usuário `rampa` do PostgreSQL; o Compose monta a DATABASE_URL do app com ela. Só
# letras e números (entra na URL): `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# Linha do htpasswd do basic auth do Traefik (staging privado), ENTRE ASPAS SIMPLES (o hash
# tem `$`): `htpasswd -nbB usuario 'senha'`.
RAMPA_BASIC_AUTH=
# Registro das imagens `rampa-app` e `rampa-scanner` (padrão: o GHCR do dono do repositório).
RAMPA_REGISTRY=
# Usuário e senha do basic auth em TEXTO PURO (`usuario:senha`), só para o `deploy.sh`
# conferir o app pelo proxy (200 em /api/health); nunca vai para um container. Obrigatória.
RAMPA_HEALTHCHECK_AUTH=
# Faixa da rede `rampa_edge` (proxy → app) e o gateway dela. Mude só se colidir com outra rede
# da máquina. O TRUSTED_PROXIES (acima) é o endereço do proxy visto pelo app nessa rede.
RAMPA_EDGE_SUBNET=172.30.240.0/24
RAMPA_EDGE_GATEWAY=172.30.240.1
# Nome do entrypoint HTTPS e do resolver de certificados do Traefik da máquina (obrigatórios,
# sem padrão: dependem da configuração do proxy).
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
